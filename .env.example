# Connexion HFSQL — lue UNIQUEMENT par le processus principal (jamais le renderer).
# Copier ce fichier en `.env` (déjà gitignoré) et renseigner les valeurs réelles.

# Nom du pilote ODBC tel qu'enregistré dans l'administrateur ODBC Windows.
# Souvent "HFSQL" ; à ajuster si le driver porte un autre nom.
HFSQL_DRIVER=HFSQL

HFSQL_HOST=127.0.0.1
HFSQL_PORT=4900
HFSQL_DATABASE=sicocompte
HFSQL_USER=admin
HFSQL_PASSWORD=
